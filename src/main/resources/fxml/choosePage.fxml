<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="be.esi.prj.bookle.mvp.view.ChoosePageController"
            prefWidth="900" prefHeight="600" style="-fx-background-color: #001f3f;">

    <!-- Zone de recherche -->
    <VBox layoutX="50" layoutY="30" spacing="10" prefWidth="600">
        <children>
            <Label text="Search a scanned book page" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;" />
            <TextField fx:id="titleField" promptText="Enter book title..." />
            <TextField fx:id="pageField" promptText="Optional: page number..." />
            <Button text="Search" onAction="#handleSearch" style="-fx-background-color: #0074D9; -fx-text-fill: white; -fx-font-weight: bold;" />
        </children>
    </VBox>

    <!-- Liste des résultats -->
    <Label layoutX="50" layoutY="180" text="Scanned pages:" style="-fx-text-fill: white; -fx-font-size: 14px;" />
    <ListView fx:id="resultsList" layoutX="50" layoutY="210" prefHeight="230" prefWidth="600" />

    <!-- Bouton retour -->
    <Button fx:id="btnBack" text="⬅ Back" layoutX="50" layoutY="460"
            onAction="#handleBack"
            style="-fx-background-color: black; -fx-text-fill: white; -fx-border-color: white; -fx-font-weight: bold;" />
</AnchorPane>
