<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: transparent;" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="be.esi.prj.bookle.mvp.view.ConfigUserController">

    <!-- Arrière-plan -->
    <ImageView fitHeight="600.0" fitWidth="900.0" pickOnBounds="true">
        <Image url="@../assets/background.jpeg" />
    </ImageView>

    <!-- Titre -->
    <Label layoutX="378.0" layoutY="50.0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white; -fx-effect: dropshadow(gaussian, black, 5, 0.5, 0, 1);" text="Select a gamePlayer" />

    <!-- Liste des joueurs -->
    <ScrollPane hbarPolicy="NEVER" layoutX="144.0" layoutY="100.0" prefHeight="362.0" prefWidth="631.0" style="-fx-background-color: transparent; -fx-background-insets: 0; -fx-padding: 0;" vbarPolicy="AS_NEEDED">
        <content>
            <VBox fx:id="playerListVBox" alignment="CENTER" prefHeight="364.0" prefWidth="611.0" spacing="10">
            </VBox>
        </content>
    </ScrollPane>

    <!-- Boutons fléchés et ajout -->
    <Button fx:id="btnReturn" layoutX="390.0" layoutY="508.0" mnemonicParsing="false" onAction="#handleReturnToConfig" opacity="0.7" prefHeight="40.0" prefWidth="60.0" style="-fx-background-color: black; -fx-border-color: white;" text="⬅" textFill="WHITE">
      <font>
         <Font name="System Bold" size="14.0" />
      </font></Button>

    <Button fx:id="bntAddPlayer" layoutX="470.0" layoutY="508.0" mnemonicParsing="false" onAction="#handleAddPlayer" opacity="0.7" prefHeight="40.0" prefWidth="60.0" style="-fx-background-color: black; -fx-border-color: white;" text="+" textFill="WHITE">
      <font>
         <Font name="System Bold" size="14.0" />
      </font></Button>
</AnchorPane>
